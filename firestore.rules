rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default catch-all: ALLOW ALL for simplified device sync without Firebase Auth
    match /{document=**} {
      allow read, write: if true;
    }

    // --- Users ---
    match /users/{userId} {
      allow read, write: if true;
    }

    // --- Letters In ---
    match /letters_in/{letterId} {
      allow read, write: if true;
    }

    // --- Letters Out ---
    match /letters_out/{letterId} {
      allow read, write: if true;
    }

    // --- Dispositions ---
    match /dispositions/{dispId} {
      allow read, write: if true;
    }

    // --- Memos ---
    match /memos/{memoId} {
      allow read, write: if true;
    }

    // --- Meetings ---
    match /meetings/{meetId} {
      allow read, write: if true;
    }

    // --- Audit Logs ---
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // --- Settings ---
    match /settings/{setId} {
      allow read, write: if true;
    }

    // --- AI Logs ---
    match /ai_logs/{logId} {
      allow read, write: if true;
    }
  }
}
